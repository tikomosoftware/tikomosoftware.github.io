-- Algorithms in Prism :: a small deterministic finite automaton.
-- The DFA accepts binary numbers divisible by 3.

step(state: Num, bit: Num) : Num  <-
  state match
    0  =>  if bit == 0 then 0 else 1
    1  =>  if bit == 0 then 2 else 0
    _  =>  if bit == 0 then 1 else 2

runDfa(state: Num, bits: List[Num]) : Num  <-
  bits match
    []        =>  state
    [h, ..t]  =>  runDfa(step(state, h), t)

accepts(bits: List[Num]) : Bool  <-  runDfa(0, bits) == 0

main : () !console  <-
  show!console "dfa accepts 110  = {accepts([1, 1, 0])}"
  show!console "dfa accepts 1011 = {accepts([1, 0, 1, 1])}"
  show!console "dfa final 1001   = {runDfa(0, [1, 0, 0, 1])}"
