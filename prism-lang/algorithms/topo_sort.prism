-- Algorithms in Prism :: topological sort with Kahn's algorithm.
-- Removing a node means filtering it out of the node list and dropping its outgoing edges.

Edge : Dep{ before: Num, after: Num }

removeNode(x: Num, xs: List[Num]) : List[Num]  <-
  xs match
    []        =>  []
    [h, ..t]  =>
      (x == h) match
        true   =>  t
        false  =>  [h, ..removeNode(x, t)]

hasIncoming(n: Num, edges: List[Edge]) : Bool  <-
  edges match
    []        =>  false
    [e, ..t]  =>
      e match
        Dep{before, after}  =>
          (after == n) match
            true   =>  true
            false  =>  hasIncoming(n, t)

withoutOutgoing(n: Num, edges: List[Edge]) : List[Edge]  <-
  edges match
    []        =>  []
    [e, ..t]  =>
      e match
        Dep{before, after}  =>
          (before == n) match
            true   =>  withoutOutgoing(n, t)
            false  =>  [e, ..withoutOutgoing(n, t)]

pickZero(nodes: List[Num], edges: List[Edge]) : Num  ?Cycle  <-
  nodes match
    []        =>  fail Cycle
    [h, ..t]  =>
      hasIncoming(h, edges) match
        true   =>  try pickZero(t, edges)
        false  =>  h

topo(nodes: List[Num], edges: List[Edge]) : List[Num]  ?Cycle  <-
  nodes match
    []  =>  []
    _   =>
      n <- try pickZero(nodes, edges)
      [n, ..try topo(removeNode(n, nodes), withoutOutgoing(n, edges))]

topoText(nodes: List[Num], edges: List[Edge]) : Text  <-
  topo(nodes, edges) match
    ok order  =>  "{order}"
    fail _    =>  "cycle"

dagEdges : List[Edge]  <-
  [
    Dep{ before: 1, after: 3 },
    Dep{ before: 2, after: 3 },
    Dep{ before: 3, after: 4 },
    Dep{ before: 2, after: 5 }
  ]

cycleEdges : List[Edge]  <-
  [
    Dep{ before: 1, after: 2 },
    Dep{ before: 2, after: 1 }
  ]

main : () !console  <-
  show!console "topological order = {topoText([1, 2, 3, 4, 5], dagEdges)}"
  show!console "cycle detection   = {topoText([1, 2], cycleEdges)}"
