-- Algorithms in Prism :: fixed-size matrix algorithms.
-- A 2x2 matrix is a record; multiplication and exponentiation are pure value transforms.

Mat2 : M2{ a: Num, b: Num, c: Num, d: Num }

identity : Mat2  <-  M2{ a: 1, b: 0, c: 0, d: 1 }

add(x: Mat2, y: Mat2) : Mat2  <-
  M2{ a: x.a + y.a, b: x.b + y.b, c: x.c + y.c, d: x.d + y.d }

mul(x: Mat2, y: Mat2) : Mat2  <-
  M2{
    a: x.a * y.a + x.b * y.c,
    b: x.a * y.b + x.b * y.d,
    c: x.c * y.a + x.d * y.c,
    d: x.c * y.b + x.d * y.d
  }

det(m: Mat2) : Num  <-  m.a * m.d - m.b * m.c

pow(m: Mat2, n: Num) : Mat2  <-
  (n == 0) match
    true   =>  identity
    false  =>  mul(m, pow(m, n - 1))

main : () !console  <-
  fib <- M2{ a: 1, b: 1, c: 1, d: 0 }
  m   <- pow(fib, 5)
  show!console "fib matrix ^5 = {m}"
  show!console "det fib       = {det(fib)}"
  show!console "matrix sum    = {add(fib, identity)}"
