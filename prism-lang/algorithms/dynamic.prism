-- Algorithms in Prism :: dynamic-programming recurrences without mutable tables.
-- The definitions are intentionally direct. They show the recurrence; memoization is outside v0.

Item : Thing{ weight: Num, value: Num }

maxN(a: Num, b: Num) : Num  <-  if a < b then b else a

minN(a: Num, b: Num) : Num  <-  if a < b then a else b

min3(a: Num, b: Num, c: Num) : Num  <-  minN(a, minN(b, c))

length(xs: List[Num]) : Num  <-
  xs match
    []        =>  0
    [h, ..t]  =>  1 + length(t)

fib(n: Num) : Num  <-
  (n < 2) match
    true   =>  n
    false  =>  fib(n - 1) + fib(n - 2)

stairs(n: Num) : Num  <-
  (n < 2) match
    true   =>  1
    false  =>  stairs(n - 1) + stairs(n - 2)

coinWays(amount: Num, coins: List[Num]) : Num  <-
  (amount == 0) match
    true   =>  1
    false  =>
      (amount < 0) match
        true   =>  0
        false  =>
          coins match
            []        =>  0
            [c, ..cs]  =>  coinWays(amount - c, coins) + coinWays(amount, cs)

knapsack(capacity: Num, items: List[Item]) : Num  <-
  (capacity < 1) match
    true   =>  0
    false  =>
      items match
        []        =>  0
        [i, ..t]  =>
          i match
            Thing{weight, value}  =>
              (weight > capacity) match
                true   =>  knapsack(capacity, t)
                false  =>  maxN(knapsack(capacity, t), value + knapsack(capacity - weight, t))

editDistance(xs: List[Num], ys: List[Num]) : Num  <-
  xs match
    []        =>  length(ys)
    [x, ..xt]  =>
      ys match
        []        =>  length(xs)
        [y, ..yt]  =>
          (x == y) match
            true   =>  editDistance(xt, yt)
            false  =>  1 + min3(editDistance(xt, ys), editDistance(xs, yt), editDistance(xt, yt))

main : () !console  <-
  items <- [
    Thing{ weight: 2, value: 3 },
    Thing{ weight: 3, value: 4 },
    Thing{ weight: 4, value: 5 },
    Thing{ weight: 5, value: 8 }
  ]
  show!console "fib(10)             = {fib(10)}"
  show!console "stairs(5)           = {stairs(5)}"
  show!console "coin ways 5 [1,2,5] = {coinWays(5, [1, 2, 5])}"
  show!console "knapsack cap 8      = {knapsack(8, items)}"
  show!console "edit distance       = {editDistance([1, 2, 3], [1, 3, 4])}"
