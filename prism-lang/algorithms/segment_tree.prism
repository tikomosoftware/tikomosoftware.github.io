-- Algorithms in Prism :: immutable segment tree for range sums.
-- Build, query, and update all return values; no tree node is mutated in place.

Seg : Empty  or  Node{ lo: Num, hi: Num, sum: Num, left: Seg, right: Seg }

sumOf(t: Seg) : Num  <-
  t match
    Empty  =>  0
    Node{lo, hi, sum, left, right}  =>  sum

build(xs: List[Num], lo: Num, hi: Num) : Seg  <-
  (lo > hi) match
    true   =>  Empty
    false  =>
      (lo == hi) match
        true   =>  Node{ lo: lo, hi: hi, sum: at(xs, lo), left: Empty, right: Empty }
        false  =>
          mid <- floor((lo + hi) / 2)
          l   <- build(xs, lo, mid)
          r   <- build(xs, mid + 1, hi)
          Node{ lo: lo, hi: hi, sum: sumOf(l) + sumOf(r), left: l, right: r }

query(qlo: Num, qhi: Num, t: Seg) : Num  <-
  t match
    Empty  =>  0
    Node{lo, hi, sum, left, right}  =>
      (qhi < lo) match
        true   =>  0
        false  =>
          (hi < qlo) match
            true   =>  0
            false  =>
              (qlo <= lo) match
                true   =>  if hi <= qhi then sum else query(qlo, qhi, left) + query(qlo, qhi, right)
                false  =>  query(qlo, qhi, left) + query(qlo, qhi, right)

update(pos: Num, value: Num, t: Seg) : Seg  <-
  t match
    Empty  =>  Empty
    Node{lo, hi, sum, left, right}  =>
      (lo == hi) match
        true   =>  Node{ lo: lo, hi: hi, sum: value, left: Empty, right: Empty }
        false  =>
          mid <- floor((lo + hi) / 2)
          (pos <= mid) match
            true   =>
              nl <- update(pos, value, left)
              Node{ lo: lo, hi: hi, sum: sumOf(nl) + sumOf(right), left: nl, right: right }
            false  =>
              nr <- update(pos, value, right)
              Node{ lo: lo, hi: hi, sum: sumOf(left) + sumOf(nr), left: left, right: nr }

main : () !console  <-
  t  <- build([3, 1, 4, 1, 5], 0, 4)
  t2 <- update(2, 10, t)
  show!console "segment sum 1..3 = {query(1, 3, t)}"
  show!console "segment sum all  = {query(0, 4, t)}"
  show!console "after update     = {query(1, 3, t2)}"
